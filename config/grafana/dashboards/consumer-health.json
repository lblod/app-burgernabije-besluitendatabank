    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Jobs that have been busy for more than 24 hours. These are usually stuck.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
