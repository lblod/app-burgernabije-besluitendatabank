_:union0 rdf:type owl:Class;
  owl:unionOf (besluit:Agendapunt besluit:Stemming).
_:union1 rdf:type owl:Class;
  owl:unionOf (besluit:Artikel besluit:Besluit).
_:union2 rdf:type owl:Class;
  owl:unionOf (besluit:Agendapunt besluit:Artikel besluit:Besluit).
_:union3 rdf:type owl:Class;
  owl:unionOf (besluit:Bestuurseenheid besluit:Bestuursorgaan ext:BeleidsdomeinCode ext:BestuurseenheidClassificatieCode ext:BestuursfunctieCode ext:BestuursorgaanClassificatieCode ext:MandatarisStatusCode).
_:union4 rdf:type owl:Class;
  owl:unionOf (ext:BeleidsdomeinCode ext:BestuursfunctieCode ext:MandatarisStatusCode).
_:union5 rdf:type owl:Class;
  owl:unionOf (besluit:Agendapunt besluit:BehandelingVanAgendapunt).
_:union6 rdf:type owl:Class;
  owl:unionOf (besluit:BehandelingVanAgendapunt besluit:Stemming).
_:union7 rdf:type owl:Class;
  owl:unionOf (besluit:Bestuurseenheid besluit:Bestuursorgaan).
_:union8 rdf:type owl:Class;
  owl:unionOf (ext:BestuurseenheidClassificatieCode ext:BestuursorgaanClassificatieCode).
_:union9 rdf:type owl:Class;
  owl:unionOf (besluit:BehandelingVanAgendapunt besluit:Zitting).

