<http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote/properties/NUMBER-OF-ABSTENTIONS>
  sh:path besluit:aantalOnthouders;
  sh:minCount 0;
  sh:maxCount 1;
  sh:dataType xsd:decimal.
<http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote> sh:property <http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote/properties/NUMBER-OF-OPPONENTS>.
<http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote/properties/NUMBER-OF-OPPONENTS>
  sh:path besluit:aantalTegenstanders;
  sh:minCount 0;
  sh:maxCount 1;
  sh:dataType xsd:decimal.
<http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote> sh:property <http://services.redpencil.io/mu-cl-resources/my-resources/shapes/vote/properties/NUMBER-OF-PROPONENTS>.
